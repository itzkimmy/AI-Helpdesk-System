# =============================================================================
# Beyond2U AI-Powered IT Helpdesk - Environment Configuration
# =============================================================================
# Copy this file to .env and replace placeholder values.
# NEVER commit .env with real credentials to source control.
# =============================================================================

# --- Flask ---
FLASK_CONFIG=development
# CHANGE THIS in production - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-generate-a-real-secret-key

# --- Database ---
# Development (Docker MySQL)
DATABASE_URL=mysql+pymysql://helpdesk_user:CHANGE-ME-db-password@localhost:3306/helpdesk_db
# Testing (SQLite in-memory)
TEST_DATABASE_URL=sqlite:///

# MySQL Docker settings
MYSQL_ROOT_PASSWORD=CHANGE-ME-root-password
MYSQL_DATABASE=helpdesk_db
MYSQL_USER=helpdesk_user
MYSQL_PASSWORD=CHANGE-ME-db-password

# --- SLA Configuration ---
# Warning threshold as percentage (0-100) of elapsed time before deadline
SLA_WARNING_THRESHOLD_PCT=75
# SLA scanner interval in seconds
SLA_SCAN_INTERVAL_SECONDS=60

# --- Session ---
# Session lifetime in minutes
SESSION_LIFETIME_MINUTES=60
# Permanent session lifetime in minutes (remember me)
PERMANENT_SESSION_LIFETIME_MINUTES=1440

# --- Security ---
# Trusted hosts (comma-separated). Set for production.
TRUSTED_HOSTS=
# Maximum request body size in bytes (default 16MB)
MAX_CONTENT_LENGTH=16777216
# Login throttle: max attempts before lockout
LOGIN_MAX_ATTEMPTS=5
# Login throttle: lockout duration in seconds
LOGIN_LOCKOUT_SECONDS=900

# --- Timezone ---
DISPLAY_TIMEZONE=Asia/Kuala_Lumpur

# --- ML Models ---
# Path to model directory (relative to app root)
ML_MODEL_DIR=app/ml/models
